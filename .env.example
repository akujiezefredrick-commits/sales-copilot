# Copy to .env and fill in

# Which AI does the analysis: gemini (free tier) or anthropic
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey  (GEMINI_MODEL blank = gemini-3.6-flash)
GEMINI_API_KEY=
GEMINI_MODEL=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-company
APIFY_WEBSITE_ACTOR=apify/website-content-crawler
APIFY_PROFILE_ACTOR=harvestapi/linkedin-profile-scraper
APIFY_POSTS_ACTOR=harvestapi/linkedin-profile-posts

# Typeform: Connect > Webhooks > secret
TYPEFORM_SECRET=
# Field refs (Typeform question "ref" values)
TF_REF_FULL_NAME=
TF_REF_EMAIL=
TF_REF_PHONE=
TF_REF_WEBSITE=
TF_REF_LINKEDIN=
# Optional question: founder's personal LinkedIn profile
TF_REF_FOUNDER_LINKEDIN=

# Google Sheets (service account JSON path; share the sheet with its client_email)
GOOGLE_SA_JSON=./service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1
